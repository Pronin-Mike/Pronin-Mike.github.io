# Скопируйте этот файл в .env.local и подставьте свои значения:
#   Supabase → Project Settings → API
#
# .env.local НЕ коммитится (он в .gitignore).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Необязательно: base-путь сборки для GitHub Pages.
# Project site (https://<user>.github.io/<repo>/) → /<repo>/
# User site (https://<user>.github.io/)          → /
# По умолчанию — "/". В workflow деплоя подставляется автоматически.
# VITE_BASE_PATH=/home-cookbook/
